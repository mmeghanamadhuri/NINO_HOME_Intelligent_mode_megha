# Voice input is ES8311 Aux-in (Sirena AUX-out). Onboard MEMS is unused.
menu "NiNO audio"

    config NINO_ONBOARD_MIC_LOOPBACK
        bool
        default n
        help
            Unused. Onboard mic loopback is disabled; Aux-in is capture-only.

endmenu

menu "NiNO Eye Displays"

    choice NINO_EYE_DISPLAY
        prompt "Eye panel type"
        default NINO_EYE_DISPLAY_TFT

        config NINO_EYE_DISPLAY_OLED
            bool "SSD1351 OLED (Waveshare 1.27\" 128x96)"
            help
                Dual Waveshare SSD1351 RGB OLED modules. No backlight pin.
                Uses shadow framebuffer + delta SPI to reduce flicker.

        config NINO_EYE_DISPLAY_TFT
            bool "ST7735 TFT (1.44\" SPI 128x128)"
            help
                Dual 1.44 inch ST7735 SPI TFT modules (128x128 RGB565).
                Tie BL/LED to 3.3 V — GPIO 19 is SDIO CMD (Wi-Fi) on this board.
                Shared SPI: SCK 23, MOSI 22, DC 21, RST 6, CS 32/33.
                Battery ADC is GPIO 20; do not put TFT RST on GPIO 20.
    endchoice

    config NINO_ST7735_BL_HARDCODED_3V3
        bool "ST7735 backlight wired to 3.3 V (do not use GPIO 19)"
        depends on NINO_EYE_DISPLAY_TFT
        default y
        help
            GPIO 19 is SDIO CMD to the onboard ESP32-C6 (and USB D- on the
            Function EV Board). Tie TFT BL/LED to 3.3 V and enable this so
            st7735_init() never claims GPIO 19 (required for Wi-Fi/BLE).

endmenu
