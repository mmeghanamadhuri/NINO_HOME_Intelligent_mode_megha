# Copy to server/.env and adjust paths/secrets for your machine.
# Loaded automatically on server startup when python-dotenv is installed.

# Phase A + B — PostgreSQL conversation + long-term memory
DATABASE_URL=postgresql://nino:nino@127.0.0.1:5432/nino_memory

# Phase B (defaults ON when DATABASE_URL is set; set 0 to disable)
# MEMORY_EXTRACTION=1
MEMORY_MIN_IMPORTANCE=5
MEMORY_TOP_MEMORIES=10
MEMORY_RECENT_TURNS=10

# Phase C — daily summaries (off by default)
# MEMORY_SUMMARY_CRON=0

# LLM
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b

# Cloud STT/TTS — ElevenLabs (Scribe STT + TTS)
# Replace the placeholder with your real key; leave unset to use Whisper/local TTS.
ELEVENLABS_API_KEY=sk_c2dcc2c3b463c4b75a0de7e9786c36e82bb9c87fff774007
# STT_PROVIDER=elevenlabs   # auto | elevenlabs | whisper
# TTS_PROVIDER=elevenlabs   # auto | elevenlabs | sapi | local

# ESP playback — auto-derived from CAMERA_SOURCE if unset (http://<ESP_IP>/play_wav).
# Override explicitly if needed:
# ESP_PLAY_WAV_URL=http://192.168.0.89/play_wav

# Live camera -> OLED eye mirror (optional). Empathy TTS always sends eyes via
# /play_wav even when this is 0. Enable after flashing firmware with HTTP LRU fix.
VISION_EYE_STREAM_ENABLED=0

# Camera frame rotation (applied before face detection + live feed)
# Values: none | cw90 | ccw90 | 180  (or 90 / -90 / 270)
CAMERA_ROTATION=none

# Vision emotion (P1 — camera CNN empathy; voice WebSocket stays P0)
# All *_S settings are SECONDS (not milliseconds).
VISION_EMOTION_ENABLED=1
# keras needs tensorflow (not installed in this venv). Use FER+ ONNX instead.
# EMOTION_BACKEND=keras
EMOTION_BACKEND=ferplus
# EMOTION_KERAS_MODEL_PATH=     # default: server/data/models/emotion_model_best.h5
# VISION_EMOTION_WINDOW_MIN_S=2.0
# VISION_EMOTION_WINDOW_MAX_S=2.5
VISION_EMOTION_COOLDOWN_S=1000   # 5 minutes
# VISION_EMOTION_AFTER_VOICE_SECONDS=90
# EMOTION_MIN_CONFIDENCE=0.12
# EMOTION_NEUTRAL_SUPPRESS_RATIO=0.22
# EMOTION_SPEAKABLE_MIN=0.12


export MEMORY_SUMMARY_CRON=1
VISION_EMOTION_AFTER_SUMMARY_GREETING_S=180   # seconds (default 180)