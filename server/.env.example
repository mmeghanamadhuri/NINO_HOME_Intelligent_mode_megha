# Copy to server/.env and adjust paths/secrets for your machine.
# Loaded automatically on server startup when python-dotenv is installed.

# Phase A + B — PostgreSQL conversation + long-term memory
DATABASE_URL=postgresql://nino:nino@127.0.0.1:5432/nino_memory

# Phase B (defaults ON when DATABASE_URL is set; set 0 to disable)
# MEMORY_EXTRACTION=1
MEMORY_MIN_IMPORTANCE=5
MEMORY_TOP_MEMORIES=10
MEMORY_RECENT_TURNS=10

# Phase C — daily summaries (off by default)
# MEMORY_SUMMARY_CRON=0
# MEMORY_SUMMARY_CRON_TIME=00:05

# LLM
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
VOICE_REPLY_TEMPERATURE=0.72
VOICE_REPLY_TOP_P=0.92

# Live football scores — create a free API-Football key at api-football.com.
# The free plan supports live scores but is limited to 100 requests/day.
# FOOTBALL_API_KEY=paste-your-api-football-key-here

# TTS: ElevenLabs Flash primary with a preloaded Piper fallback.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_TTS_SPEED=1.0
# ELEVENLABS_TTS_FALLBACK_COOLDOWN_SECONDS=60
# PIPER_PRELOAD=1
# PIPER_MODEL_PATH=./models/en_GB-southern_english_female-low.onnx
# PIPER_LENGTH_SCALE=1.15  # >1.0 slower; <1.0 faster

# ESP playback
# ESP_PLAY_WAV_URL=http://192.168.0.98/play_wav

# PC voice WebSocket URL pushed to ESP on prompt_ack (face registration listen)
# VOICE_WS_URL=ws://192.168.0.100:8000/voice-query
# NINO_SERVER_LAN_HOST=192.168.0.100
# NINO_SERVER_PORT=8000

# Camera emotion — AWS Rekognition with local DrGM fallback (see docs/SERVER_INTEGRATION.md)
# EMOTION_ENABLED=1
# EMOTION_BACKEND=auto          # auto | aws | local
# EMOTION_INTERVAL_S=0.5        # min seconds between emotion inferences on live feed
# Optional AWS keys (or use server/emotion-aws-local/.env instead):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# Automatic voice face registration (unknown face → prompt → name → capture)
# FACE_REG_ENABLED=1
# FACE_REG_UNKNOWN_SECONDS=3
# FACE_REG_PROMPT_COOLDOWN_SECONDS=600
# FACE_REG_SAMPLES=15
# FACE_REG_INTERVAL_MS=150
# FACE_REG_AWAIT_NAME_SECONDS=45
# FACE_REG_NO_SPEECH_RETRY_SECONDS=6
# FACE_REG_LISTEN_OPEN_DELAY_SECONDS=3
# FACE_REG_MAX_NO_SPEECH_RETRIES=2
# FACE_REG_UNKNOWN_CONFIRM_FRAMES=8

# Face detection quality (reduce false positives on walls / textures)
# FACE_YUNET_SCORE=0.68
# FACE_HAAR_FALLBACK=0
# FACE_LANDMARK_VALIDATION=1
# FACE_MIN_AREA_RATIO=0.0025
# FACE_MIN_ASPECT=0.72
# FACE_MAX_ASPECT=1.38
# FACE_DETECT_MIN_SIZE=32

# Face recognition quality (reduces mis-ID and ghost identities)
# FACE_MATCH_THRESHOLD=0.44
# FACE_MATCH_SOFT_THRESHOLD=0.42
# FACE_MATCH_MARGIN_MIN=0.08
# FACE_CONFIRM_FRAMES=5
# FACE_CONFIRM_FRAMES_SWITCH=8
# FACE_EMBED_MIN_CENTROID_SIM=0.80
# FACE_RECOGNITION_MIN_DETECTION_SCORE=0.72
# FACE_SESSION_PRIMARY_HOLD_SECONDS=45
# FACE_SESSION_CLEAR_UNKNOWN_FRAMES=12
# FACE_VOICE_VIEWER_HOLD_SECONDS=30
# VOICE_VIEWER_TTL_SECONDS=120
