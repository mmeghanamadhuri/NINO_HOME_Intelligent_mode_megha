# Copy to server/.env and adjust paths/secrets for your machine.
# Loaded automatically on server startup when python-dotenv is installed.

# Phase A + B — PostgreSQL conversation + long-term memory
DATABASE_URL=postgresql://nino:nino@127.0.0.1:5432/nino_memory

# Phase B (defaults ON when DATABASE_URL is set; set 0 to disable)
# MEMORY_EXTRACTION=1
MEMORY_MIN_IMPORTANCE=5
MEMORY_TOP_MEMORIES=10
MEMORY_RECENT_TURNS=10

# Phase C — daily summaries (off by default)
# MEMORY_SUMMARY_CRON=0
# MEMORY_SUMMARY_CRON_TIME=00:05

# LLM — Qwen2.5-VL-3B (text + vision); pull with: ollama pull qwen2.5vl:3b
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Vision object/scene backend (replaces YOLO when set to qwen-vl).
# OBJECT_DETECTION_BACKEND=qwen-vl
# VISION_LLM_INTERVAL_S=2.0
# VISION_LLM_IMGSZ=512
# WHAT_YOU_SEE_USE_LLM=1
# MJPEG_LIGHTWEIGHT=1
# MJPEG_TARGET_FPS=24
# MULTI_DEVICE_VISION_INTERVAL_S=0.35
# CAMERA_SNAPSHOT_POLL_S=0.02
VOICE_REPLY_TEMPERATURE=0.72
VOICE_REPLY_TOP_P=0.92

# Live football scores — create a free API-Football key at api-football.com.
# The free plan supports live scores but is limited to 100 requests/day.
# FOOTBALL_API_KEY=paste-your-api-football-key-here

# Music streaming to the robot speaker — needs ffmpeg (apt) and pycryptodome (pip).
# Songs resolve via JioSaavn; the board pulls PCM from /music/stream.wav.
# See docs/music_stream.md for the firmware endpoints this depends on.
# MUSIC_STREAM_HZ=32000
# MUSIC_STREAM_HOST=192.168.1.100:8000
# MUSIC_ENABLE_YTDLP=1

# STT: local faster-whisper on GPU (default). Cloud Scribe is opt-in.
STT_PROVIDER=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE_INDEX=0
WHISPER_PRELOAD=1
VOICE_MIN_ENERGY=5
OLLAMA_FORCE_GPU=1
# TTS: local Piper (or set elevenlabs for cloud TTS).
# STT_PROVIDER=elevenlabs
# TTS_PROVIDER=piper
# TTS_PROVIDER=kokoro
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_TTS_SPEED=1.0
# ELEVENLABS_TTS_FALLBACK_COOLDOWN_SECONDS=60
# PIPER_PRELOAD=1
# PIPER_MODEL_PATH=./models/en_US-amy-low.onnx
# PIPER_LENGTH_SCALE=1.0
# PIPER_NOISE_SCALE=0.667
# PIPER_NOISE_W_SCALE=0.8
# PIPER_SENTENCE_SILENCE=0.5
# PIPER_PITCH_SEMITONES=4.0
# PIPER_PITCH_BACKEND=ffmpeg   # ffmpeg asetrate+atempo (tempo preserved) or numpy
# PIPER_ROBOTIC=0             # 0=warm natural timbre, 1=strong AM / metallic edge
# PIPER_PROSODY=1          # modulate Piper pitch/speed/volume from spoken mood
# KOKORO_PRELOAD=1
# KOKORO_MODEL_PATH=./models/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=./models/voices-v1.0.bin
# KOKORO_VOICE=bf_emma       # British female; also bf_alice, bf_lily, bm_george
# KOKORO_LANG=en-gb          # en-us for American voices (af_sarah, af_bella, ...)
# KOKORO_SPEED=1.0           # 0.5–2.0; >1.0 faster

# ESP playback
# ESP_PLAY_WAV_URL=http://192.168.0.98/play_wav

# PC voice WebSocket URL pushed to ESP on prompt_ack (face registration listen)
# VOICE_WS_URL=ws://192.168.0.100:8000/voice-query
# NINO_SERVER_LAN_HOST=192.168.0.100
# NINO_SERVER_PORT=8000

# OTA — upload a .bin then push it to a robot by MAC (device_id).
# Robots pull from http://<NINO_SERVER_LAN_HOST>:<port>/api/ota/firmware/<id>/bin
# First firmware flash after the OTA partition change must be a full idf.py flash.
# curl -F file=@build/USB_Camera.bin http://<server>:8000/api/devices/<mac>/ota/upload
# NINO_OTA_TOKEN=optional-shared-secret
# NINO_OTA_MAX_BYTES=12582912
# NINO_OTA_DIR=./data/firmware

# Camera emotion — AWS Rekognition with local DrGM fallback (see docs/SERVER_INTEGRATION.md)
# EMOTION_ENABLED=1
# EMOTION_BACKEND=auto          # auto | aws | local
# EMOTION_INTERVAL_S=0.5        # min seconds between emotion inferences on live feed
# Optional AWS keys (or use server/emotion-aws-local/.env instead):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# Automatic voice face registration is retired. Stream session_identity
# owns greet / register-offer / guest. Keep FACE_REG_ENABLED=0.
# FACE_REG_ENABLED=0
# VISION_FACE_GREETING_ENABLED=0
# FACE_REG_UNKNOWN_SECONDS=3
# FACE_REG_PROMPT_COOLDOWN_SECONDS=600
# FACE_REG_SAMPLES=15
# FACE_REG_INTERVAL_MS=150
# FACE_REG_AWAIT_NAME_SECONDS=45
# FACE_REG_NO_SPEECH_RETRY_SECONDS=6
# FACE_REG_LISTEN_OPEN_DELAY_SECONDS=3
# FACE_REG_MAX_NO_SPEECH_RETRIES=2
# FACE_REG_UNKNOWN_CONFIRM_FRAMES=8

# Face detection quality (reduce false positives on walls / textures)
# FACE_YUNET_SCORE=0.68
# FACE_HAAR_FALLBACK=0
# FACE_LANDMARK_VALIDATION=1
# FACE_MIN_AREA_RATIO=0.0025
# FACE_MIN_ASPECT=0.72
# FACE_MAX_ASPECT=1.38
# FACE_DETECT_MIN_SIZE=32

# Face recognition quality (reduces mis-ID and ghost identities)
# FACE_MATCH_THRESHOLD=0.44
# FACE_MATCH_SOFT_THRESHOLD=0.42
# FACE_MATCH_MARGIN_MIN=0.08
# FACE_CONFIRM_FRAMES=5
# FACE_CONFIRM_FRAMES_SWITCH=8
# FACE_EMBED_MIN_CENTROID_SIM=0.80
# FACE_RECOGNITION_MIN_DETECTION_SCORE=0.72
# FACE_SESSION_PRIMARY_HOLD_SECONDS=45
# FACE_SESSION_CLEAR_UNKNOWN_FRAMES=12
# FACE_VOICE_VIEWER_HOLD_SECONDS=30
# VOICE_VIEWER_TTL_SECONDS=120
# Voice speaker profiling (ECAPA via SpeechBrain; cross-checks with face identity)
# VOICE_PROFILE_ENABLED=1
# VOICE_MATCH_THRESHOLD=0.72
# VOICE_MATCH_SOFT_THRESHOLD=0.66
# VOICE_MATCH_MARGIN_MIN=0.06
# VOICE_ENROLL_MIN_SAMPLES=3
# VOICE_ENROLL_MAX_SAMPLES=8
# VOICE_MIN_AUDIO_SECONDS=0.6
# VOICE_LOOK_SCAN_COOLDOWN_S=20
# Open-palm stop: raise a hand toward the camera to interrupt and listen.
# PALM_GESTURE_ENABLED=1
# PALM_MIN_AREA=0.03
# PALM_HITS_NEEDED=2
# PALM_COOLDOWN_S=2.5
# Streamed Aux-in end-of-speech (energy VAD). Same start for wake and in-session.
# ASR_EOS_START_ENERGY=12
# ASR_EOS_CONTINUE_ENERGY=12
# ASR_EOS_QUIET_ENERGY=5
# ASR_EOS_SPEECH_MS=80
# ASR_EOS_SILENCE_MS=450
# ASR_EOS_MAX_MS=30000
# ASR_EOS_MIN_SPEECH_MS=200

# Vision greeting: probability of greeting + yesterday DB context (else plain greeting)
# FACE_GREETING_DB_PROBABILITY=0.5
# FACE_GREETING_INTERVAL_SECONDS=600
# VISION_GREETING_AFTER_VOICE_SECONDS=90
# Intelligent Mode — detect, fix, verify, and email ops reports
# INTELLIGENT_MODE=1
# INTELLIGENT_AUTONOMOUS_RECOVERY=1  # multi-step fix chains within Intelligent Mode
# INTELLIGENT_RECOVERY_CHAIN_STEPS=2
# INTELLIGENT_AUTONOMOUS_MAX_TIER=2
# INTELLIGENT_RETRY_ESCALATED=1
# INTELLIGENT_SMOKE_TESTS=1
# INTELLIGENT_POLL_SECONDS=45
# INTELLIGENT_GRACE_SECONDS=90
# INTELLIGENT_VERIFY_DELAY_SECONDS=12
# INTELLIGENT_VERIFICATION_LIVE_PROBES=1
# INTELLIGENT_MAX_FIX_ATTEMPTS=3
# Phase 1 — reorder recovery chains by historical fix success rates
# INTELLIGENT_FIX_HISTORY=1
# INTELLIGENT_FIX_HISTORY_MIN_SAMPLES=2
# Phase 2 — LLM picks next whitelisted recovery action (still validated before run)
# INTELLIGENT_LLM_FIX_SELECTION=1
# INTELLIGENT_LLM_FIX_MIN_CONFIDENCE=medium
# Phase 2b — learn from verified outcomes (playbook + fix-history weighting)
# INTELLIGENT_EXPERIENCE_PLAYBOOK=1
# INTELLIGENT_LEARN_FROM_VERIFICATION=1
# Phase 3 — statistical baseline anomalies (voice latency, bot probe, smoke fail ratio)
# INTELLIGENT_BASELINE_ANOMALY=1
# INTELLIGENT_BASELINE_SIGMA=3.0
# INTELLIGENT_BASELINE_MIN_SAMPLES=20
# INTELLIGENT_BASELINE_GRACE_SECONDS=120
# INTELLIGENT_EMAIL_TO=you@example.com
# INTELLIGENT_SMTP_HOST=smtp.gmail.com
# INTELLIGENT_SMTP_PORT=587
# INTELLIGENT_SMTP_USER=you@example.com
# INTELLIGENT_SMTP_PASSWORD=app-password-here
# INTELLIGENT_SMTP_FROM=NiNO Server <you@example.com>
# INTELLIGENT_SMTP_TLS=1
# INTELLIGENT_LLM_REPORTS=1
# INTELLIGENT_EMAIL_ON_RESOLVE=1
# INTELLIGENT_EMAIL_ON_ESCALATE=1
# INTELLIGENT_EMAIL_MODE=digest
# INTELLIGENT_EMAIL_DIGEST_SECONDS=900
# INTELLIGENT_CAMERA_GRACE_SECONDS=120
# INTELLIGENT_LLM_GRACE_SECONDS=120
# INTELLIGENT_PRUNE_ON_START=0
# INTELLIGENT_INCIDENTS_KEEP_RESOLVED=50
# INTELLIGENT_INCIDENTS_STORE_MAX=10000
# INTELLIGENT_STT_EMPTY_THRESHOLD=3
# INTELLIGENT_STT_EMPTY_WINDOW_SECONDS=600
# INTELLIGENT_LATENCY_FAILURE_MAX_AGE_SECONDS=900
# INTELLIGENT_FIX_COOLDOWN_SECONDS=60
# INTELLIGENT_MAX_AUTO_FIX_TIER=1
# INTELLIGENT_EMAIL_CODE_BUGS=1
# INTELLIGENT_AUTO_OTA=0
# INTELLIGENT_OTA_FIRMWARE=nino_home.bin
# OLLAMA_HTTP_RETRIES=6
# OLLAMA_HTTP_RETRY_DELAY_S=0.4
# Docs: docs/intelligent-mode/README.md

# Daily training — learn from each day's data (default ON; never deletes history)
# DAILY_TRAINING=1
# DAILY_TRAINING_TIME=02:00

# Firmware OTA — upload .bin via Ops UI, deploy to bots over HTTP
# OTA_REQUIRE_APPROVAL=1
# OTA_FIRMWARE_HOST=192.168.0.100

# Coding Agent — parallel smart bug fixing (runs alongside server)
# CODING_AGENT_ENABLED=1
# CODING_AGENT_EMAIL=1
# CODING_AGENT_SMART=1
# CODING_AGENT_PARALLEL=2
# CODING_AGENT_POLL_SECONDS=30
# CODING_AGENT_RUN_TESTS=1
# CODING_AGENT_MODEL=qwen2.5-coder:32b
# CODING_AGENT_APPROVAL_TOKEN=change-me-to-a-secret
# CODING_AGENT_TIMEOUT_S=120
# CODING_AGENT_NUM_PREDICT=2000
# CODING_AGENT_RESTART_SCRIPT=./scripts/restart_nino_server.sh
# Required model (coding agent only — voice still uses OLLAMA_MODEL):
#   ollama pull qwen2.5-coder:32b

# VOICE_HTTP_PLAY_WAV_DEVICES=b0a6048addd4  # comma-separated MACs that play TTS via HTTP /play_wav only
